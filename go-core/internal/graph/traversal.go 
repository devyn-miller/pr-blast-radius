package graph

import "time"

type ChangeType string

const (
	ChangeAdded           ChangeType = "Added"
	ChangeModified        ChangeType = "Modified"
	ChangeDeleted         ChangeType = "Deleted"
	ChangeSignatureChanged ChangeType = "SignatureChanged"
)

type ChangedSymbol struct {
	SymbolID   NodeID
	ChangeType ChangeType
}

type AffectedNode struct {
	NodeID          NodeID
	Distance        int
	Path            []NodeID // root -> ... -> this node
	SeverityScore   float64
	SeverityReasons []string
}

type BlastRadiusResult struct {
	RootSymbols         []ChangedSymbol
	AffectedNodes       []AffectedNode
	MaxDepthUsed        int
	TotalNodesAffected  int
	TotalEdgesTraversed int
	ExecutionTime       time.Duration
}

// Traverser takes an ALREADY-BUILT *Graph as pure input. Deliberately
// decoupled from BuildGraph — cycle-handling and BFS correctness are
// tested here against small, hand-authored graph literals, with zero
// dependency on parsing, git, or I/O of any kind.
type Traverser struct {
	g *Graph
}

func NewTraverser(g *Graph) *Traverser {
	return &Traverser{g: g}
}

// bfsQueueItem carries the accumulated path and the weakest edge
// confidence seen along it, since severity scoring (next unit) needs
// "weakest link on path," not just distance.
type bfsQueueItem struct {
	nodeID           NodeID
	distance         int
	path             []NodeID
	weakestOnPath    float32
}

// ComputeBlastRadius performs REVERSE BFS from every root (via g.InEdges —
// "who calls me," not "who do I call"), bounded by maxDepth, with a
// visited-set keyed by NodeID. This is the ONLY place cycle-safety is
// enforced in the whole system, and it's enforced by a single map, not
// scattered defensive checks — the simplest correct design.
func (t *Traverser) ComputeBlastRadius(roots []ChangedSymbol, maxDepth int) BlastRadiusResult {
	start := time.Now()

	visited := make(map[NodeID]bool)
	var affected []AffectedNode
	edgesTraversed := 0

	queue := make([]bfsQueueItem, 0, len(roots))
	for _, root := range roots {
		visited[root.SymbolID] = true // roots themselves are never re-visited or double-emitted
		queue = append(queue, bfsQueueItem{
			nodeID: root.SymbolID, distance: 0,
			path: []NodeID{root.SymbolID}, weakestOnPath: 1.0,
		})
	}

	for len(queue) > 0 {
		item := queue[0]
		queue = queue[1:]

		if item.distance >= maxDepth {
			continue // depth cap reached — do not enqueue further, but the node itself was already recorded when first visited
		}

		for _, edge := range t.g.InEdges[item.nodeID] {
			edgesTraversed++
			caller := edge.From

			if visited[caller] {
				continue // cycle guard: a mutually-recursive caller is never re-enqueued or double-recorded
			}
			visited[caller] = true

			weakest := item.weakestOnPath
			if edge.Confidence < weakest {
				weakest = edge.Confidence
			}

			newPath := append(append([]NodeID{}, item.path...), caller)

			affected = append(affected, AffectedNode{
				NodeID:   caller,
				Distance: item.distance + 1,
				Path:     newPath,
				// SeverityScore/SeverityReasons populated by package
				// `severity` in a separate pass over this result — kept
				// out of Traverser deliberately (see prior architecture note
				// on why traversal and scoring are split packages).
			})

			queue = append(queue, bfsQueueItem{
				nodeID: caller, distance: item.distance + 1,
				path: newPath, weakestOnPath: weakest,
			})
		}
	}

	return BlastRadiusResult{
		RootSymbols:         roots,
		AffectedNodes:       affected,
		MaxDepthUsed:        maxDepth,
		TotalNodesAffected:  len(affected),
		TotalEdgesTraversed: edgesTraversed,
		ExecutionTime:       time.Since(start),
	}
}